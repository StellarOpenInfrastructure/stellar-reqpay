# stellar-reqpay server configuration. Placeholder values only — never commit real credentials.

NODE_ENV=development
HOST=0.0.0.0
PORT=4030
LOG_LEVEL=info

# Public base URL embedded in hosted links and status_url
PUBLIC_BASE_URL=http://localhost:4030

# PostgreSQL; unset = in-memory (development only)
DATABASE_URL=postgres://reqpay:reqpay@localhost:5432/reqpay

# testnet | mainnet | custom
STELLAR_NETWORK=testnet
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE=

# Issuer signing key (S...). Generate a dedicated key; publish its public key as
# URI_REQUEST_SIGNING_KEY in your stellar.toml. Leave unset to issue unsigned requests.
# REQPAY_SIGNING_SEED=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MERCHANT_NAME=Example Merchant
MERCHANT_DOMAIN=merchant.example

# Default request lifetime (seconds) when the client omits expires_at/expires_in
DEFAULT_EXPIRY_SECONDS=900

# Poll Horizon for payments to open requests every N seconds (0 = disabled)
WATCH_INTERVAL_SECONDS=0

CORS_ORIGINS=*
